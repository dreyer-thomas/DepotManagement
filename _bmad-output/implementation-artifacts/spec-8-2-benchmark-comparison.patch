+const OPTIONS: PerformancePanelProps["options"] = [
+  { key: "msci-world", label: "MSCI World", line: WORLD },
+  { key: "dax", label: "DAX", line: null },
+  { key: "portfolio", label: "Gesamtportfolio", line: LINE },
+  { key: "depot:b", label: "Zweitdepot", line: WORLD },
+];
+
+const realGetComputedStyle = window.getComputedStyle.bind(window);
+beforeEach(() => {
+  vi.spyOn(window, "getComputedStyle").mockImplementation((element: Element, pseudo?: string | null) => {
+    const style = realGetComputedStyle(element, pseudo);
+    return new Proxy(style, {
+      get(target, key) {
+        if (key === "width") return "600px";
+        if (key === "height") return "200px";
+        const value: unknown = Reflect.get(target, key);
+        return typeof value === "function" ? (value as (...args: unknown[]) => unknown).bind(target) : value;
+      },
+    });
+  });
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  document.cookie = "dm_benchmark=; path=/; max-age=0";
+});
+
+function renderPanel(initialChoice = "none") {
+  return render(
+    <ThemeProvider theme={theme}>
+      <PerformancePanel scopeLabel="Hauptdepot" line={LINE} options={OPTIONS} initialChoice={initialChoice} />
+    </ThemeProvider>,
+  );
+}
+
+const figure = () => screen.getByRole("figure").getAttribute("aria-label");
