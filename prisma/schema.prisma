// Prisma schema. Models are added by later stories; the ledger module owns its models.
// Money, quantities and prices are TEXT decimal strings (never Decimal/Float).

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Broker {
  COMDIRECT
  DEUTSCHE_BANK
  FINANZEN_ZERO
}

// Owned by the ledger module. The Cash Account is implicit (one per Depot); its balance is
// computed on read and never stored.
model Depot {
  id     String @id @default(cuid())
  name   String @unique
  broker Broker
}
