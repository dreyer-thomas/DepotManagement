// Prisma schema. Models are added by later stories; the ledger module owns its models.
// Money, quantities and prices are TEXT decimal strings (never Decimal/Float).

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Broker {
  COMDIRECT
  DEUTSCHE_BANK
  FINANZEN_ZERO
}

// Owned by the ledger module. The Cash Account is implicit (one per Depot); its balance is
// computed on read and never stored.
model Depot {
  id     String @id @default(cuid())
  name   String @unique
  broker       Broker
  /// Archived Depots are read-only and left out of Portfolio figures (AD-17).
  archived     Boolean       @default(false)
  transactions Transaction[]
}

enum AssetType {
  STOCK
  ETF
  FUND
  CERTIFICATE
  CRYPTO
  UNCLASSIFIED
}

// All AD-14 types are declared; story 1.4 writes only BUY and SELL.
enum TransactionType {
  BUY
  SELL
  DIVIDEND
  FEE
  TAX
  DEPOSIT
  WITHDRAWAL
}

// Owned by the ledger module; created only via ledger.ensureSecurity.
model Security {
  id           String        @id @default(cuid())
  isin         String?       @unique
  cryptoSymbol String?       @unique
  name         String
  assetType        AssetType
  transactions     Transaction[]
  corporateActions CorporateAction[] @relation("CorporateActionSecurity")
  /// ISIN changes whose new Security this is.
  isinChangeSources CorporateAction[] @relation("IsinChangeTarget")
  providerMapping   ProviderMapping?
  prices            Price[]
}

// Canonical Transaction shape (AD-14). Decimal values are TEXT strings; ordered by (date, sequence).
model Transaction {
  id         String          @id @default(cuid())
  depotId    String
  depot      Depot           @relation(fields: [depotId], references: [id])
  securityId String?
  security   Security?       @relation(fields: [securityId], references: [id], onDelete: Restrict)
  type       TransactionType
  /// Business date YYYY-MM-DD (Europe/Berlin).
  date       String
  sequence   Int
  quantity   String?
  price      String?
  amount     String
  fee        String
  tax        String

  @@unique([depotId, date, sequence])
  @@index([securityId])
}

enum CorporateActionType {
  SPLIT
  ISIN_CHANGE
}

// Owned by the ledger module (AD-7). Security-scoped: applies in every Depot. Stored Transactions and
// Prices are never modified; core applies corporate actions on read.
// SPLIT: ratioOld:ratioNew as TEXT integers; newSecurityId is null.
// ISIN_CHANGE: securityId is the old Security, newSecurityId the new one; ratioOld / ratioNew hold the
// canonical old / new quantity as TEXT decimals (ratioOld units of the old became ratioNew of the new).
model CorporateAction {
  id            String              @id @default(cuid())
  securityId    String
  security      Security            @relation("CorporateActionSecurity", fields: [securityId], references: [id], onDelete: Restrict)
  newSecurityId String?
  newSecurity   Security?           @relation("IsinChangeTarget", fields: [newSecurityId], references: [id], onDelete: Restrict)
  type          CorporateActionType
  /// Business date YYYY-MM-DD (Europe/Berlin); applies before every Transaction of that date (AD-8).
  date          String
  ratioOld      String
  ratioNew      String

  @@unique([securityId, type, date])
  @@index([securityId])
  @@index([newSecurityId])
}

enum PriceProvider {
  YAHOO
  ONVISTA
  COINGECKO
}

enum MappingOrigin {
  AUTO
  MANUAL
}

// Owned by the prices module (AD-9). At most one row per Security. A row is either mapped
// (provider + symbol both set) or a "not found" marker (both null) recording that auto-resolution ran.
model ProviderMapping {
  id         String         @id @default(cuid())
  securityId String         @unique
  security   Security       @relation(fields: [securityId], references: [id], onDelete: Cascade)
  provider   PriceProvider?
  symbol     String?
  origin     MappingOrigin
  /// UTC ISO timestamp of the last write.
  updatedAt  String
  /// Business date the stored provider history starts at (first activity date of the last full
  /// backfill); null until a full backfill succeeded. Reset when the mapping changes.
  historyFrom String?
  /// UTC ISO timestamp of the last successful price fetch.
  fetchedAt   String?
  /// Reason of the last failed price fetch (`network`, `not-found`, `currency`, `schema`, `unexpected`); null after a success.
  fetchError  String?
}

enum PriceSource {
  MANUAL
  PROVIDER
}

// Owned by the prices module (AD-9). Unadjusted as-traded close per business date; `price` is a TEXT
// decimal string. Provider rows are replaced by fetches; MANUAL rows are never written by provider code.
model Price {
  id         String      @id @default(cuid())
  securityId String
  security   Security    @relation(fields: [securityId], references: [id], onDelete: Cascade)
  /// Business date YYYY-MM-DD (Europe/Berlin).
  date       String
  source     PriceSource
  price      String
  /// UTC ISO timestamp of the fetch (or entry).
  fetchedAt  String

  @@unique([securityId, date, source])
}
