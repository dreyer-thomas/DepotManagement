// Prisma schema. Models are added by later stories; the ledger module owns its models.
// Money, quantities and prices are TEXT decimal strings (never Decimal/Float).

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Broker {
  COMDIRECT
  DEUTSCHE_BANK
  FINANZEN_ZERO
}

// Owned by the ledger module. The Cash Account is implicit (one per Depot); its balance is
// computed on read and never stored.
model Depot {
  id                 String              @id @default(cuid())
  name               String              @unique
  broker             Broker
  /// Archived Depots are read-only and left out of Portfolio figures (AD-17).
  archived           Boolean             @default(false)
  transactions       Transaction[]
  /// Import staging of this Depot (owned by the import module; rows cascade with the Depot).
  importBatches      ImportBatch[]
  /// Reconciliation runs against broker statements (owned by the ledger module; cascade with the Depot).
  reconciliationRuns ReconciliationRun[]
}

enum AssetType {
  STOCK
  ETF
  FUND
  CERTIFICATE
  CRYPTO
  UNCLASSIFIED
}

// All AD-14 types. ADJUSTMENT (holding correction, story 2.9): signed quantity, unit cost in `price`
// for a positive quantity, amount/fee/tax 0, no cash effect.
enum TransactionType {
  BUY
  SELL
  DIVIDEND
  FEE
  TAX
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

// Owned by the ledger module; created only via ledger.ensureSecurity.
model Security {
  id                 String              @id @default(cuid())
  isin               String?             @unique
  cryptoSymbol       String?             @unique
  name               String
  assetType          AssetType
  transactions       Transaction[]
  corporateActions   CorporateAction[]   @relation("CorporateActionSecurity")
  /// ISIN changes whose new Security this is.
  isinChangeSources  CorporateAction[]   @relation("IsinChangeTarget")
  providerMapping    ProviderMapping?
  prices             Price[]
  logo               SecurityLogo?
  classification     SecurityClassification?
  /// Teilfreistellung override (owned by the tax module; cascades with the Security).
  teilfreistellung   TeilfreistellungOverride?
  newsArticles       NewsArticle[]
  newsFetch          NewsFetch?
  reconciliationRows ReconciliationRow[]
  /// Watchlist entries of this Security (owned by the watchlist module; cascade with the Security).
  watchlistEntries   WatchlistEntry[]
  /// Key-figures snapshot (owned by the classification module; disposable cache, cascades with the Security).
  keyFigures         SecurityKeyFigures?
}

// Canonical Transaction shape (AD-14). Decimal values are TEXT strings; ordered by (date, sequence).
model Transaction {
  id         String          @id @default(cuid())
  depotId    String
  depot      Depot           @relation(fields: [depotId], references: [id])
  securityId String?
  security   Security?       @relation(fields: [securityId], references: [id], onDelete: Restrict)
  type       TransactionType
  /// Business date YYYY-MM-DD (Europe/Berlin).
  date       String
  sequence   Int
  quantity   String?
  price      String?
  amount     String
  fee        String
  tax        String
  /// Optional user note (≤ 200 characters), e.g. "Kontoabgleich" on a reconciliation cash correction.
  note       String?

  @@unique([depotId, date, sequence])
  @@index([securityId])
}

enum CorporateActionType {
  SPLIT
  ISIN_CHANGE
}

// Owned by the ledger module (AD-7). Security-scoped: applies in every Depot. Stored Transactions and
// Prices are never modified; core applies corporate actions on read.
// SPLIT: ratioOld:ratioNew as TEXT integers; newSecurityId is null.
// ISIN_CHANGE: securityId is the old Security, newSecurityId the new one; ratioOld / ratioNew hold the
// canonical old / new quantity as TEXT decimals (ratioOld units of the old became ratioNew of the new).
model CorporateAction {
  id            String              @id @default(cuid())
  securityId    String
  security      Security            @relation("CorporateActionSecurity", fields: [securityId], references: [id], onDelete: Restrict)
  newSecurityId String?
  newSecurity   Security?           @relation("IsinChangeTarget", fields: [newSecurityId], references: [id], onDelete: Restrict)
  type          CorporateActionType
  /// Business date YYYY-MM-DD (Europe/Berlin); applies before every Transaction of that date (AD-8).
  date          String
  ratioOld      String
  ratioNew      String

  @@unique([securityId, type, date])
  @@index([securityId])
  @@index([newSecurityId])
}

enum ReconciliationStatus {
  OPEN
  FINISHED
}

// Owned by the ledger module (story 2.9). A reconciliation run of one Depot against a broker statement:
// user-entered data (statement values, checks), never derived; app values are computed on read. At most one
// OPEN run per Depot (service-enforced). Part of the AD-12 export/restore.
model ReconciliationRun {
  id            String               @id @default(cuid())
  depotId       String
  depot         Depot                @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// Business date YYYY-MM-DD (Europe/Berlin) of the broker statement.
  statementDate String
  status        ReconciliationStatus @default(OPEN)
  /// UTC ISO timestamp of the start.
  createdAt     String
  /// UTC ISO timestamp of "Abgleich abschließen"; null while OPEN.
  finishedAt    String?
  rows          ReconciliationRow[]

  @@index([depotId])
}

// Owned by the ledger module (story 2.9). One user-entered row of a run: a Position (securityId) or the
// Cash Account (securityId null; SQLite NULLs are distinct, so the service looks the cash row up itself).
// `statementValue` is a canonical decimal string (quantity or EUR balance).
model ReconciliationRow {
  id             String            @id @default(cuid())
  runId          String
  run            ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  securityId     String?
  security       Security?         @relation(fields: [securityId], references: [id], onDelete: Restrict)
  statementValue String?
  checked        Boolean           @default(false)

  @@unique([runId, securityId])
  @@index([securityId])
}

enum PriceProvider {
  YAHOO
  ONVISTA
  COINGECKO
}

enum MappingOrigin {
  AUTO
  MANUAL
}

// Owned by the prices module (AD-9). At most one row per Security. A row is either mapped
// (provider + symbol both set) or a "not found" marker (both null) recording that auto-resolution ran.
model ProviderMapping {
  id          String         @id @default(cuid())
  securityId  String         @unique
  security    Security       @relation(fields: [securityId], references: [id], onDelete: Cascade)
  provider    PriceProvider?
  symbol      String?
  origin      MappingOrigin
  /// UTC ISO timestamp of the last write.
  updatedAt   String
  /// Business date the stored provider history starts at (first activity date of the last full
  /// backfill); null until a full backfill succeeded. Reset when the mapping changes.
  historyFrom String?
  /// UTC ISO timestamp of the last successful price fetch.
  fetchedAt   String?
  /// Reason of the last failed price fetch (`network`, `not-found`, `currency`, `schema`, `unexpected`); null after a success.
  fetchError  String?
}

enum PriceSource {
  MANUAL
  PROVIDER
}

// Owned by the prices module (AD-9). Unadjusted as-traded close per business date; `price` is a TEXT
// decimal string. Provider rows are replaced by fetches; MANUAL rows are never written by provider code.
model Price {
  id         String      @id @default(cuid())
  securityId String
  security   Security    @relation(fields: [securityId], references: [id], onDelete: Cascade)
  /// Business date YYYY-MM-DD (Europe/Berlin).
  date       String
  source     PriceSource
  price      String
  /// UTC ISO timestamp of the fetch (or entry).
  fetchedAt  String

  @@unique([securityId, date, source])
}

enum LogoSource {
  FETCHED
  MANUAL
}

enum LogoProvider {
  LOGO_DEV
  ELBSTREAM
  COINGECKO
}

// Owned by the logos module (AD-19). At most one row per Security. A row either names a stored file under
// `<DATA_DIR>/logos` (fileName + contentType both set) or is a FETCHED "nothing found" marker (both null).
// MANUAL rows (uploads) are never replaced by a fetch.
model SecurityLogo {
  id          String        @id @default(cuid())
  securityId  String        @unique
  security    Security      @relation(fields: [securityId], references: [id], onDelete: Cascade)
  source      LogoSource
  /// Provider of a fetched file; null for MANUAL rows and for the "nothing found" marker.
  provider    LogoProvider?
  fileName    String?
  contentType String?
  /// UTC ISO timestamp of the fetch (or upload).
  fetchedAt   String
}

enum NewsProvider {
  GOOGLE_NEWS
  YAHOO
  /// Yahoo Finance RSS headline feed per Yahoo symbol (story 3-8); items carry a teaser.
  YAHOO_RSS
}

// Owned by the news module (AD-11). Cached headlines per held Security; not ledger data, never backed up.
// A refresh replaces all rows of a Security at once.
model NewsArticle {
  id          String       @id @default(cuid())
  securityId  String
  security    Security     @relation(fields: [securityId], references: [id], onDelete: Cascade)
  url         String
  title       String
  source      String
  /// UTC ISO timestamp of publication.
  publishedAt String
  provider    NewsProvider
  /// Short plain-text teaser (tags and entities stripped, at most 600 characters); null = no teaser.
  teaser      String?
  /// UTC ISO timestamp of the fetch.
  fetchedAt   String

  @@unique([securityId, url])
}

// Owned by the news module (AD-11). Last successful news refresh of a Security.
model NewsFetch {
  securityId String   @id
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  /// UTC ISO timestamp of the last successful refresh.
  fetchedAt  String
}

enum ImportBatchStatus {
  OPEN
  BOOKED
}

enum ImportItemStatus {
  PARSED
  FAILED
  /// The document needs no booking (e.g. a comdirect Steuermitteilung merged into its Ertragsgutschrift).
  NO_BOOKING
  /// A corporate-action notice read as an ISIN-change proposal (story 5-6); `proposals` holds `[isinChange]`.
  CORPORATE_ACTION
}

// Owned by the import module (AD-4). Staging only: nothing here is ledger data. One batch per upload for
// one Depot; OPEN until booked or discarded (a discard deletes the rows and the batch's PDF directory).
model ImportBatch {
  id        String            @id @default(cuid())
  depotId   String
  depot     Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  status    ImportBatchStatus @default(OPEN)
  /// UTC ISO timestamp of the upload.
  createdAt String
  items     ImportItem[]

  @@index([depotId])
  @@index([status])
}

// Owned by the import module (AD-4). One row per uploaded file, in upload order (`position`, 0-based).
// `storedFile` is the generated file name (`<id>.pdf`) under `<DATA_DIR>/imports/<batchId>/`, null when
// the file was not kept (too large, not a PDF). `proposals` is a JSON array of AD-14-shaped Transaction
// proposals (decimal strings), validated with the proposal schema on read; a CORPORATE_ACTION item holds
// exactly one ISIN-change proposal there instead, validated with its own schema.
model ImportItem {
  id              String           @id @default(cuid())
  batchId         String
  batch           ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position        Int
  fileName        String
  /// SHA-256 of the file bytes (hex); a hash already stored on another item only warns (re-upload).
  fileHash        String
  /// True when another item had the same hash at upload time.
  duplicateUpload Boolean          @default(false)
  storedFile      String?
  status          ImportItemStatus
  documentType    String?
  /// German text: the failure reason (FAILED), the review note (PARSED, optional) or the info (NO_BOOKING).
  reason          String?
  proposals       String           @default("[]")
  /// JSON array aligned with `proposals`: the review decision per proposal, `"book" | "discard" | null`.
  decisions       String           @default("[]")
  /// First readable `dd.mm.yyyy` date of a parser-failed file as `YYYY-MM-DD` (prefills manual entry).
  documentDate    String?

  @@unique([batchId, position])
  @@index([fileHash])
}

enum ClassificationSource {
  PROVIDER
  RULE
}

// Owned by the classification module (AD-20, story 7.1). At most one row per Security. Per dimension an
// automatic value (`x` + `xSource`, written only by the refresh) and a manual override (`xManual`, written
// only by the user; always wins, never touched by the refresh). Values are German labels; null = unknown.
// The type dimension is the ledger's `assetType` and is not stored here.
model SecurityClassification {
  id                String                @id @default(cuid())
  securityId        String                @unique
  security          Security              @relation(fields: [securityId], references: [id], onDelete: Cascade)
  assetClass        String?
  assetClassSource  ClassificationSource?
  assetClassManual  String?
  sector            String?
  sectorSource      ClassificationSource?
  sectorManual      String?
  industry          String?
  industrySource    ClassificationSource?
  industryManual    String?
  region            String?
  regionSource      ClassificationSource?
  regionManual      String?
  country           String?
  countrySource     ClassificationSource?
  countryManual     String?
  companySize       String?
  companySizeSource ClassificationSource?
  companySizeManual String?
  currency          String?
  currencySource    ClassificationSource?
  currencyManual    String?
  // Region split of a fund (story 8.4, owned by classification): JSON object of split region → percent
  // decimal string. `regionSplit` + source/asOf/index are the rule cache (written only by the refresh, not
  // exported); `regionSplitManual` is the user's split (always wins, never touched by the refresh).
  regionSplit       String?
  regionSplitSource ClassificationSource?
  regionSplitAsOf   String?
  regionSplitIndex  String?
  regionSplitManual String?
  /// Yahoo symbol of the last provider answer (data or "no data"); null while provider data is pending.
  /// A mapping symbol different from this one triggers a new fetch.
  providerSymbol    String?
  /// UTC ISO timestamp of the last provider answer.
  providerFetchedAt String?
  /// Analysten-Symbol (story 9.7): the Yahoo symbol (home listing) analyst data is fetched for; resolved
  /// once by ISIN via Yahoo search or set by the user. A provider setting, never exported.
  analystSymbol     String?
  /// True when the user set `analystSymbol`; the resolution never overwrites a manual symbol.
  analystSymbolManual Boolean @default(false)
  /// UTC ISO timestamp of the last write.
  updatedAt         String
}

// Owned by the tax module (story 8.3). Freistellungsauftrag per broker and year; `amount` is a canonical
// decimal string (EUR, > 0; a missing row counts as 0). User data, part of the AD-12 export/restore.
model TaxAllowance {
  id        String @id @default(cuid())
  broker    Broker
  year      Int
  amount    String
  /// UTC ISO timestamp of the last write.
  updatedAt String

  @@unique([broker, year])
}

// Owned by the tax module (story 8.3). Manual Teilfreistellung of a fund (`rate` one of
// core/tax TEILFREISTELLUNG_RATES as a decimal string); no row = automatic. Part of the AD-12 export/restore.
model TeilfreistellungOverride {
  id         String   @id @default(cuid())
  securityId String   @unique
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  rate       String
  /// UTC ISO timestamp of the last write.
  updatedAt  String
}

// Owned by the rebalancing module (story 8.5). Target allocation per scope: `scope` is "portfolio" or a
// Depot id (no FK: a Depot scope's row is ignored once the Depot is gone); `weights` is JSON segment →
// percent (canonical decimal strings, non-zero only, summing to 100); `threshold` is the deviation in
// percentage points below which a segment is "im Rahmen". User data, part of the AD-12 export/restore.
model TargetAllocation {
  id        String @id @default(cuid())
  scope     String @unique
  weights   String
  threshold String
  /// UTC ISO timestamp of the last write.
  updatedAt String
}

// Owned by the watchlist module (story 9.1). A named list of investment ideas; ordered by `position`
// (creation order, max + 1). `name` is trimmed NFC, ≤ 60 characters, unique case-insensitively (service).
model Watchlist {
  id        String           @id @default(cuid())
  name      String           @unique
  position  Int              @unique
  /// UTC ISO timestamp of the creation.
  createdAt String
  entries   WatchlistEntry[]
}

enum WatchlistEntrySource {
  APP
  MCP
}

// Owned by the watchlist module (story 9.1). One Security on one list (a Security may be on several
// lists). Price, changes and stale flag are computed on read by core, never stored. Cascades with its
// list and its Security (removing an entry never deletes the Security or its Prices).
model WatchlistEntry {
  id          String               @id @default(cuid())
  watchlistId String
  watchlist   Watchlist            @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  securityId  String
  security    Security             @relation(fields: [securityId], references: [id], onDelete: Cascade)
  /// Plain-text note (≤ 2000 characters); empty allowed.
  note        String               @default("")
  /// Business date YYYY-MM-DD (Europe/Berlin) the idea was added; ≤ today.
  dateAdded   String
  position    Int
  source      WatchlistEntrySource @default(APP)
  /// Name of the MCP client that created the entry; null for APP entries.
  clientName  String?
  /// UTC ISO timestamp of the creation.
  createdAt   String

  @@unique([watchlistId, securityId])
  @@index([securityId])
}

// Owned by the mcp module (story 9.4). A client registered through RFC 7591 dynamic registration.
// `redirectUris` and `grantTypes` are JSON arrays as text; a confidential client's secret is stored only
// as a SHA-256 hex hash. Never exported (AD-12); a restore clears every OAuth row.
model OAuthClient {
  id                      String       @id @default(cuid())
  clientId                String       @unique
  /// Display name (NFC-trimmed, ≤ 100 characters) shown on the consent page.
  clientName              String
  /// JSON array of the exactly registered redirect URIs.
  redirectUris            String
  /// JSON array of the registered grant types (`authorization_code`, `refresh_token`).
  grantTypes              String
  /// `none`, `client_secret_post` or `client_secret_basic`.
  tokenEndpointAuthMethod String
  clientSecretHash        String?
  /// UTC ISO timestamp of the registration.
  createdAt               String
  grants                  OAuthGrant[]
  tokens                  OAuthToken[]
}

// Owned by the mcp module (story 9.4). One connection authorized on the consent page; it exists only
// once a code has been exchanged. Revoking sets `revokedAt` and deletes its tokens.
model OAuthGrant {
  id         String       @id @default(cuid())
  clientId   String
  client     OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Space-separated granted scopes (`watchlist`).
  scope      String
  /// UTC ISO timestamps.
  createdAt  String
  lastUsedAt String?
  revokedAt  String?
  tokens     OAuthToken[]

  @@index([clientId])
}

enum OAuthTokenKind {
  CODE
  ACCESS
  REFRESH
}

// Owned by the mcp module (story 9.4). Authorization codes, access and refresh tokens, stored only as
// SHA-256 hex hashes. A code carries no grant until it is exchanged; a consumed code or refresh token is
// kept until it expires so reuse can be detected.
model OAuthToken {
  id            String         @id @default(cuid())
  kind          OAuthTokenKind
  hash          String         @unique
  clientId      String
  client        OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantId       String?
  grant         OAuthGrant?    @relation(fields: [grantId], references: [id], onDelete: Cascade)
  scope         String
  /// The protected resource (`APP_URL/api/mcp`) the token is bound to.
  resource      String
  /// PKCE S256 challenge (codes only).
  codeChallenge String?
  /// Redirect URI of the authorization request (codes only).
  redirectUri   String?
  /// UTC ISO timestamps.
  expiresAt     String
  consumedAt    String?
  createdAt     String

  @@index([grantId])
  @@index([clientId])
  @@index([expiresAt])
}

// Owned by the classification module (story 9.6). A disposable per-Security key-figures snapshot from Yahoo
// `quoteSummary`: never input to any calculation, never exported; deleted when the Security is neither
// held nor watched.
model SecurityKeyFigures {
  id         String   @id @default(cuid())
  securityId String   @unique
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  /// Yahoo symbol the snapshot was fetched for.
  symbol     String
  /// Kind of figures: "stock" or "fund" (ETF/fund); a different kind than the current asset type is ignored.
  kind       String
  /// JSON object of decimal strings, business dates and texts (null = not delivered).
  figures    String
  /// Yahoo symbol the analyst part was fetched for (story 9.7; STOCK only, null = not requested).
  analystSymbol String?
  /// JSON of `AnalystRatings` (core/analyst-ratings); null = no analyst data.
  analysts   String?
  /// UTC ISO timestamp of the fetch.
  fetchedAt  String
}
