# DepotManagement configuration (AD-18). Copy to `.env` and fill in; never commit `.env`.
# Empty values are treated as unset.

# SQLite database URL. Empty = file:<home>/.depotmanagement/depot.db (outside the source tree).
DATABASE_URL=

# Login (required; the app refuses to start if any of the three is missing or invalid).
# Secret for signing the session cookie, at least 32 characters: `openssl rand -base64 48`.
SESSION_SECRET=
# Single-user login name.
AUTH_USERNAME=
# bcrypt hash of the password: run `npm run hash-password` and paste the printed line.
# Write every `$` as `\$` (the script does this), otherwise Next.js expands it as a variable.
AUTH_PASSWORD_HASH=

# Directory for daily SQLite backups and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=

# Price, identifier and logo provider API keys.
COINGECKO_API_KEY=
OPENFIGI_API_KEY=
LOGO_DEV_API_KEY=

# Directory for stored data files such as Security logos.
DATA_DIR=
