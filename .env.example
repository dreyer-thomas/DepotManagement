# DepotManagement configuration (AD-18). Copy to `.env` and fill in; never commit `.env`.
# Empty values are treated as unset.

# SQLite database URL. Empty = file:<home>/.depotmanagement/depot.db (outside the source tree).
DATABASE_URL=

# Login (required; the app refuses to start if any of the three is missing or invalid).
# Secret for signing the session cookie, at least 32 characters: `openssl rand -base64 48`.
SESSION_SECRET=
# Single-user login name.
AUTH_USERNAME=
# bcrypt hash of the password: run `npm run hash-password` and paste the printed line.
# Write every `$` as `\$` (the script does this), otherwise Next.js expands it as a variable.
AUTH_PASSWORD_HASH=

# Directory for daily SQLite backups and how many to keep. A restore from an export file first writes an
# automatic export of the current data here (`depotmanagement-export-<YYYYMMDD-HHMMSS>.json`).
# Empty = <home>/.depotmanagement/backups.
BACKUP_DIR=
BACKUP_KEEP=

# Price, identifier and logo provider API keys.
COINGECKO_API_KEY=
OPENFIGI_API_KEY=
# logo.dev publishable key (`pk_…`); used server-side only. Empty = logo.dev is skipped and logos come
# from Elbstream (and CoinGecko for crypto).
LOGO_DEV_API_KEY=

# Directory for stored data files: Security logos (under `<DATA_DIR>/logos`) and uploaded broker PDFs
# (under `<DATA_DIR>/imports`, kept until their import batch is booked or discarded).
# Empty = <home>/.depotmanagement/data.
DATA_DIR=
